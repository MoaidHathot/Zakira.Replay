{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zakira.local/replay/schemas/manifest.schema.json",
  "title": "Zakira.Replay Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "visionInstruction",
    "ocrInstruction",
    "createdAt",
    "runId",
    "frames",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["0.8", "0.9"] },
    "source": { "type": "string", "minLength": 1 },
    "visionInstruction": { "type": "string" },
    "ocrInstruction": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string", "minLength": 1 },
    "title": { "type": ["string", "null"] },
    "webpageUrl": { "type": ["string", "null"] },
    "duration": { "type": ["string", "null"] },
    "audioPath": { "type": ["string", "null"] },
    "transcriptPath": { "type": ["string", "null"] },
    "ocrPath": { "type": ["string", "null"] },
    "ocrStepsPath": { "type": ["string", "null"], "description": "Relative path of ocr/steps.json: the deduplicated, timestamped list of distinct on-screen text lines (first/last seen, occurrences, frame ids); ocr/steps.md is the readable form. Present when OCR ran." },
    "visionPath": { "type": ["string", "null"] },
    "evidencePath": { "type": ["string", "null"] },
    "frames": {
      "type": "array",
      "items": { "$ref": "#/$defs/frameArtifact" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/replayWarning" }
    },
    "timings": {
      "description": "Wall-clock seconds per pipeline stage. Stages absent from the map did not run. Stage names are open (orchestrators must tolerate unknown keys); see RunTimingStages for the canonical set used by AnalysisPipeline.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalSeconds", "stages"],
          "properties": {
            "totalSeconds": { "type": "number", "minimum": 0 },
            "stages": {
              "type": "object",
              "additionalProperties": { "type": "number", "minimum": 0 }
            }
          }
        }
      ]
    },
    "secondaryTranscripts": {
      "description": "Additional-language transcripts written alongside transcriptPath when the run was configured with --secondary-transcripts. Empty/absent when only the primary transcript was produced.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/secondaryTranscriptArtifact" }
        }
      ]
    },
    "sessionMetadata": {
      "description": "Deterministic source-page-derived metadata about the session (title, speakers, abstract, etc.) extracted from JSON-LD/OpenGraph/HTML during browser capture. Null when not browser-captured or when nothing was parseable.",
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sessionMetadata" }
      ]
    },
    "status": {
      "description": "Run outcome. completed: every stage ran (warnings may still be present). partial: the pipeline stopped early but something usable exists (transcript, frames or audio). failed: the pipeline stopped early with nothing beyond request/metadata. Absent in manifests written before 0.9 (treat as completed). Only completed manifests are reused by run-id/cache lookups.",
      "type": "string",
      "enum": ["completed", "partial", "failed"]
    },
    "failure": {
      "description": "Why and where the run stopped early. Null/absent for completed runs.",
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/runFailure" }
      ]
    },
    "sourceDetails": {
      "description": "Facts the source publishes, lifted from the yt-dlp probe: description, uploader/channel, upload date, counts, tags, creator chapters, and (when the run asked for them via --comments) the top comments with pinned / uploader-authored ones first. Null/absent for local files.",
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sourceDetails" }
      ]
    }
  },
  "$defs": {
    "sourceDetails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": ["string", "null"] },
        "uploader": { "type": ["string", "null"] },
        "channel": { "type": ["string", "null"] },
        "uploadDate": { "type": ["string", "null"], "description": "ISO date (YYYY-MM-DD) when yt-dlp supplied YYYYMMDD." },
        "viewCount": { "type": ["integer", "null"] },
        "likeCount": { "type": ["integer", "null"] },
        "commentCount": { "type": ["integer", "null"] },
        "tags": { "type": ["array", "null"], "items": { "type": "string" } },
        "categories": { "type": ["array", "null"], "items": { "type": "string" } },
        "chapters": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "startSeconds", "startLabel"],
            "properties": {
              "title": { "type": "string" },
              "startSeconds": { "type": "number", "minimum": 0 },
              "endSeconds": { "type": ["number", "null"], "minimum": 0 },
              "startLabel": { "type": "string" }
            }
          }
        },
        "comments": {
          "description": "At most 20 top-level comments: pinned first, then uploader-authored, then by like count; text capped at 2000 characters. The full capture is in commentsPath.",
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "isPinned", "authorIsUploader"],
            "properties": {
              "author": { "type": ["string", "null"] },
              "text": { "type": "string" },
              "likeCount": { "type": ["integer", "null"] },
              "isPinned": { "type": "boolean" },
              "authorIsUploader": { "type": "boolean" },
              "publishedAt": { "type": ["string", "null"] },
              "id": { "type": ["string", "null"] }
            }
          }
        },
        "commentsPath": { "type": ["string", "null"], "description": "Relative path of the full comment capture (comments/comments.json) when comments were requested." }
      }
    },
    "runFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "message", "exceptionType"],
      "properties": {
        "stage": { "type": "string", "minLength": 1, "description": "Pipeline stage that was running: probe, captions, media-url, media-download, audio, stt, diarization, frames, browser-captions, smart-crop, hashes, slides, ocr, vision, evidence, manifest-write." },
        "message": { "type": "string" },
        "exceptionType": { "type": "string" },
        "hint": { "type": ["string", "null"], "description": "Remediation hint when the failure matches a known signature (bot check, HTTP 429, missing JS runtime, stale yt-dlp)." },
        "outputTail": { "type": ["string", "null"], "description": "Last lines a failed or timed-out subprocess printed." },
        "cancelled": { "type": "boolean" }
      }
    },
    "sessionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "sessionCode": { "type": ["string", "null"] },
        "track": { "type": ["string", "null"] },
        "level": { "type": ["string", "null"] },
        "publishedAt": { "type": ["string", "null"] },
        "speakers": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
        "products": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
        "tags": { "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
        "sourceUrl": { "type": ["string", "null"] },
        "sources": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strategy", "fields"],
            "properties": {
              "strategy": { "type": "string", "minLength": 1 },
              "fields": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "secondaryTranscriptArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "markdownPath", "sourcePath"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "markdownPath": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 }
      }
    },
    "frameArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "timestampSeconds", "timestampLabel"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "timestampSeconds": { "type": "number", "minimum": 0 },
        "timestampLabel": { "type": "string", "minLength": 1 },
        "perceptualHash": { "type": ["string", "null"] },
        "sharpnessScore": { "type": ["number", "null"], "minimum": 0, "description": "Variance-of-Laplacian focus measure when sharpness-aware picking ran (higher is sharper)." },
        "requestedTimestampSeconds": { "type": ["number", "null"], "minimum": 0, "description": "The interval instant this frame stands for when sharpness-aware picking moved the capture off it." },
        "width": { "type": ["integer", "null"], "minimum": 0 },
        "height": { "type": ["integer", "null"], "minimum": 0 },
        "originalPath": {
          "description": "Relative path of the source frame this entry's `path` is derived from (set when a preprocessing step, e.g. smart-crop, replaced the frame on disk).",
          "type": ["string", "null"]
        },
        "crop": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/frameCropBox" }
          ]
        }
      }
    },
    "frameCropBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "source"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "source": {
          "description": "Identifier of the algorithm that produced this crop (e.g. `smart-crop-auto`, `smart-crop-teams`).",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replayWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "source": { "type": ["string", "null"] },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] }
      }
    }
  }
}
